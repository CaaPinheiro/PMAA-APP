# Copie este arquivo para .env e preencha com seus valores locais.
# O arquivo .env esta no .gitignore e nunca deve ser versionado.

DB_URL=jdbc:postgresql://localhost:5432/pmaa
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_do_postgres

# Gere uma chave longa e aleatoria. Exemplo para gerar:
#   openssl rand -base64 48
JWT_SECRET=gere-uma-chave-aleatoria-longa-aqui
JWT_EXPIRATION=86400000
